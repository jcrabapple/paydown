# Required: HTTP Basic Auth credentials
BUDGET_USER=paydown
BUDGET_PASS=change-me-to-a-strong-password

# Optional: Server port, SQLite DB path, and local timezone
BUDGET_PORT=8485
BUDGET_DB=data/budget.db
BUDGET_TZ=America/New_York

# Optional: Plaid integration (leave unset to run in manual-only mode)
# Generate PLAID_TOKEN_KEY with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PLAID_CLIENT_ID=
# PLAID_CLIENT_SECRET=
# PLAID_ENV=production
# PLAID_TOKEN_KEY=
# PLAID_REDIRECT_URI=https://your-domain.example.com/plaid-oauth.html
# PLAID_USER_ID=paydown-user
